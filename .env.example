# ---------------------------------------------------------------------------
# ExamPilot - example environment file. Copy to .env and fill in real values.
# NEVER commit a real .env file. No secrets belong in this repository.
# ---------------------------------------------------------------------------

# --- Database (docker compose exposes Postgres on host port 5433) ----------
DATABASE_URL="postgresql://exampilot:exampilot@localhost:5433/exampilot?schema=public"

# --- API -------------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
# Comma-separated list of allowed browser origins (CORS allowlist)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Auth ------------------------------------------------------------------
# 32+ byte random strings. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# --- Reminder scheduler ----------------------------------------------------
# Interval in seconds at which the backend sweeps for due reminders.
REMINDER_SWEEP_INTERVAL_SECONDS="60"
# Set to "true" to disable the in-process scheduler (e.g. when running tests).
REMINDER_SCHEDULER_DISABLED="false"

# --- Rate limiting ---------------------------------------------------------
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"
AUTH_RATE_LIMIT_MAX="20"
API_RATE_LIMIT_WINDOW_MINUTES="1"
API_RATE_LIMIT_MAX="300"

# --- Seed data (development only) -----------------------------------------
SEED_USER_EMAIL="demo@exampilot.local"
SEED_USER_PASSWORD="DemoPassword123!"

# --- Web (Vite) ------------------------------------------------------------
VITE_API_URL="http://localhost:4000"
